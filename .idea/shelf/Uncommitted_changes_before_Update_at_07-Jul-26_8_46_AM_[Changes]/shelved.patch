<+>package model;\r\n\r\npublic class Seat {\r\n    private int row;\r\n    private int col;\r\n    private boolean isPremium;\r\n    private boolean isBooked;\r\n\r\n    public Seat(int row, int col, boolean isPremium){\r\n        this.row = row;\r\n        this.col = col;\r\n        this.isPremium = isPremium;\r\n    }\r\n\r\n    public int getRow(){\r\n        return row;\r\n    }\r\n    public int getCol(){\r\n        return col;\r\n    }\r\n    public boolean isPremium(){\r\n        return isPremium;\r\n    }\r\n    public boolean isBooked(){\r\n        return isBooked;\r\n    }\r\n\r\n    public void book(){\r\n        isBooked = true;\r\n    }\r\n\r\n    public void release(){\r\n        isBooked = false;\r\n    }\r\n\r\n    public boolean isAvailable(){\r\n    if(isBooked == true)\r\n        return false;\r\n    else\r\n        return true;\r\n    }\r\n\r\n    public String toString(){\r\n        String ans = String.format(\"R%dC%d\", row, col);\r\n        if(isPremium)\r\n            ans += \"*\";\r\n        if(isBooked)\r\n            ans += \"#\";\r\n        return ans;\r\n    }\r\n}\r\n
